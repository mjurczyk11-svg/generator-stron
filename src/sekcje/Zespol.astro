---
import { strona, tlumacz, type Jezyk } from '../lib/dane';
import Sekcja from '../components/Sekcja.astro';
import Obraz from '../components/Obraz.astro';
interface Props { lang: Jezyk; tlo?: string }
const { lang, tlo } = Astro.props;
const { t } = tlumacz(lang);
---
<Sekcja klucz="zespol" lang={lang} tlo={tlo}>
  <div class="siatka siatka-4">
    {strona.zespol.lista.map((o: any) => (
      <article class="osoba">
        <Obraz plik={o.zdjecie} alt={o.imie} szerokosci={[360, 600]} sizes="(max-width: 600px) 100vw, 25vw" />
        <h3>{o.imie}</h3>
        {t(o.rola) && <p class="rola">{t(o.rola)}</p>}
        {t(o.opis) && <p>{t(o.opis)}</p>}
      </article>
    ))}
  </div>
</Sekcja>
