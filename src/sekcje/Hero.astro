---
// Pierwszy ekran. Układy: zdjecie | srodek | podzielony | panorama | kolaz | prosty (pole hero.uklad albo motyw).
import { strona, tlumacz, ocena, p, type Jezyk } from '../lib/dane';
import { godzinyTydzien, pokazGodziny, maGodziny } from '../lib/godziny';
import Obraz from '../components/Obraz.astro';
import Ikona from '../components/Ikona.astro';
import Gwiazdki from '../components/Gwiazdki.astro';
import HeroTresc from '../components/HeroTresc.astro';
interface Props { lang: Jezyk }
const { lang } = Astro.props;
const { t, u } = tlumacz(lang);
const h = strona.hero;
const uklad = h.zdjecie ? h.uklad : 'prosty';
const op = strona.opinie;
const dni = u('dni') as string[];
const tydzien = godzinyTydzien();
// Skrócone godziny: grupuje kolejne dni z tymi samymi godzinami (np. "Pon–Pt 8–17").
const grupy: { od: number; do: number; tekst: string }[] = [];
tydzien.forEach((d, i) => {
  const tekst = d.przedzialy.length ? pokazGodziny(d.przedzialy) : u('zamkniete');
  const ost = grupy.at(-1);
  if (ost && ost.tekst === tekst) ost.do = i; else grupy.push({ od: i, do: i, tekst });
});
const skrot = (i: number) => dni[i].slice(0, 3);
const godzinyKrotko = grupy.filter((g) => g.tekst !== u('zamkniete')).map((g) => `${skrot(g.od)}${g.do > g.od ? '–' + skrot(g.do) : ''} ${g.tekst}`);
// Liczby z sekcji „O nas” pokazane na pierwszym ekranie (ustawienie liczby_w_hero).
const liczby = strona.liczby_w_hero ? (strona.o_nas?.liczby ?? []) : [];
// Kolaż: zdjęcie główne + dwa kolejne (hero.zdjecie2/3, a gdy ich brak: z galerii albo realizacji).
const zapas = [
  ...(strona.galeria?.lista ?? []).map((g: any, i: number) => ({ plik: g.plik ?? g, pole: `galeria.lista.${i}.plik` })),
  ...(strona.realizacje?.lista ?? []).map((r: any, i: number) => (r.po ? { plik: r.po, pole: `realizacje.lista.${i}.po` } : null)).filter(Boolean),
];
const kolaz = [
  { plik: h.zdjecie, pole: 'hero.zdjecie' },
  h.zdjecie2 ? { plik: h.zdjecie2, pole: 'hero.zdjecie2' } : zapas[0],
  h.zdjecie3 ? { plik: h.zdjecie3, pole: 'hero.zdjecie3' } : zapas[h.zdjecie2 ? 0 : 1],
].filter((z: any) => z?.plik);
const pelny = uklad === 'zdjecie' || uklad === 'srodek';
---
{pelny && (
  <section class:list={['hero', 'hero--zdjecie', { 'hero--srodek': uklad === 'srodek', 'hero--z-liczbami': liczby.length }]}>
    <div class="hero-tlo"><Obraz plik={h.zdjecie} pole="hero.zdjecie" alt={t(h.zdjecie_opis)} szerokosci={[640, 1024, 1600, 2200]} sizes="100vw" priorytet /></div>
    <div class="kontener">
      <HeroTresc lang={lang} przycisk="btn-akcent" zOcena />
    </div>
    {liczby.length > 0 && (
      <div class="kontener hero-liczby">
        {liczby.map((l: any, i: number) => <div><strong data-licznik {...p(`o_nas.liczby.${i}.wartosc`)}>{t(l.wartosc)}</strong><span {...p(`o_nas.liczby.${i}.opis`)}>{t(l.opis)}</span></div>)}
      </div>
    )}
    {maGodziny() && !liczby.length && (
      <div class="hero-godziny"><div class="kontener"><span><Ikona n="clock" rozmiar={19} />{u('godziny')}:</span>{godzinyKrotko.map((g) => <span>{g}</span>)}</div></div>
    )}
    {uklad === 'srodek' && <a class="hero-dalej" href="#tresc-dalej" aria-label="↓"><Ikona n="chevron-down" rozmiar={22} /></a>}
  </section>
)}
{uklad === 'podzielony' && (
  <section class="hero hero--podzielony">
    <div class="kontener hero-siatka">
      <HeroTresc lang={lang} />
      <div class="hero-zdjecie">
        <Obraz plik={h.zdjecie} pole="hero.zdjecie" alt={t(h.zdjecie_opis)} szerokosci={[480, 800, 1100]} sizes="(max-width: 880px) 100vw, 46vw" priorytet />
        {op?.ocena && (
          <a class="hero-karta" href={op.link ?? '#opinie'} style="text-decoration:none">
            <Ikona n="google" rozmiar={30} />
            <div><strong>{ocena(op.ocena, lang)}</strong><Gwiazdki ocena={op.ocena} rozmiar={14} /><span class="opis">{`${op.liczba} ${u('opinie.opinii')} Google`}</span></div>
          </a>
        )}
      </div>
    </div>
    {liczby.length > 0 && (
      <div class="kontener hero-liczby hero-liczby--jasne">
        {liczby.map((l: any, i: number) => <div><strong data-licznik {...p(`o_nas.liczby.${i}.wartosc`)}>{t(l.wartosc)}</strong><span {...p(`o_nas.liczby.${i}.opis`)}>{t(l.opis)}</span></div>)}
      </div>
    )}
  </section>
)}
{uklad === 'panorama' && (
  <section class="hero hero--panorama">
    <div class="kontener">
      <HeroTresc lang={lang} zOcena />
      <div class="hero-panorama-zdjecie">
        <Obraz plik={h.zdjecie} pole="hero.zdjecie" alt={t(h.zdjecie_opis)} szerokosci={[640, 1024, 1600, 2200]} sizes="(max-width: 1240px) 100vw, 1180px" priorytet />
      </div>
    </div>
  </section>
)}
{uklad === 'kolaz' && (
  <section class="hero hero--kolaz">
    <div class="kontener hero-siatka">
      <HeroTresc lang={lang} zOcena />
      <div class:list={['hero-kolaz', `hero-kolaz--${kolaz.length}`]}>
        {kolaz.map((z: any, i: number) => (
          <div class={`kolaz-${i + 1}`}><Obraz plik={z.plik} pole={z.pole} alt={i === 0 ? t(h.zdjecie_opis) : ''} szerokosci={i === 0 ? [480, 800, 1100] : [360, 600]} sizes={i === 0 ? '(max-width: 880px) 100vw, 34vw' : '(max-width: 880px) 50vw, 20vw'} priorytet={i === 0} /></div>
        ))}
      </div>
    </div>
  </section>
)}
{uklad === 'prosty' && (
  <section class="hero hero--prosty">
    <div class="kontener">
      <HeroTresc lang={lang} przycisk="btn-akcent" />
    </div>
  </section>
)}
<span id="tresc-dalej"></span>
