---
import { strona, tlumacz, p, type Jezyk } from '../lib/dane';
import Sekcja from '../components/Sekcja.astro';
interface Props { lang: Jezyk; tlo?: string }
const { lang, tlo } = Astro.props;
const { t, u } = tlumacz(lang);
const d = strona.cennik;
const kategorie = d.kategorie ?? [{ lista: d.lista }];
const cena = (c: any) => (typeof c === 'number' ? `${d.od === false ? '' : u('cennik.od') + ' '}${c} zł` : t(c));
---
<Sekcja klucz="cennik" lang={lang} tlo={tlo}>
  <div class="cennik">
    {kategorie.map((k: any, ki: number) => (
      <div>
        {t(k.nazwa) && <h3 {...p(`cennik.kategorie.${ki}.nazwa`)}>{t(k.nazwa)}</h3>}
        <dl>{(k.pozycje ?? k.lista).map((poz: any, pi: number) => <div class="cennik-poz"><dt {...p(`cennik.kategorie.${ki}.pozycje.${pi}.nazwa`)}>{t(poz.nazwa)}</dt><dd>{cena(poz.cena)}</dd></div>)}</dl>
      </div>
    ))}
  </div>
  {t(d.uwaga) && <p class="cennik-uwaga" {...p('cennik.uwaga')}>{t(d.uwaga)}</p>}
</Sekcja>
